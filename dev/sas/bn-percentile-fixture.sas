proc stdize data=n100 outstat=stat_n100
            pctlmtd=ord_stat pctldef=1 pctlpts=2.5 16 50 84 97.5;
run;
data out_n100; length dataset $8; set stat_n100;
  dataset = "n100";
run;

proc stdize data=n4 outstat=stat_n4
            pctlmtd=ord_stat pctldef=1 pctlpts=2.5 16 50 84 97.5;
