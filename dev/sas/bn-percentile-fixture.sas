proc stdize data=n1 outstat=stat_n1
            pctlmtd=ord_stat pctldef=1 pctlpts=2.5 16 50 84 97.5;
run;
data out_n1; length dataset $8; set stat_n1;
  dataset = "n1";
run;

data expected;
  set out_n100 out_n4 out_n1;
run;

proc print data=expected noobs; run;   /* so the log shows it too */

proc export data=expected outfile="&out./bn-percentile-expected.csv"
            dbms=csv replace;
run;
